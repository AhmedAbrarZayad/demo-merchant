# Vercel Environment Variables
# Add these in Vercel Dashboard > Settings > Environment Variables

# Massivemarket API base URL (production)
MASSIVEMARKET_API_BASE_URL=https://api.massivemarket.com
MASSIVEMARKET_SHOP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MASSIVEMARKET_WEBHOOK_SECRET=replace-with-the-secret-from-the-merchant-portal
